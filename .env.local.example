# Bu dosyanin adini ".env.local" olarak kopyalayin ve degerleri kendinize gore duzenleyin.
# Degisiklikten sonra sunucuyu yeniden baslatmayi unutmayin.

# Yonetim panelinin sifresi (bos birakilirsa varsayilan: admin123)
ADMIN_SIFRE=buraya-guclu-bir-sifre-yazin

# Oturum cerezini imzalamak icin rastgele uzun bir metin (istege bagli ama onerilir)
OTURUM_ANAHTARI=rastgele-uzun-bir-metin-yazin-123456

# Fiyat verisinin tutulacagi klasor (istege bagli, varsayilan: proje icindeki "veri" klasoru)
# VERI_KLASORU=C:\Users\kullanici\Desktop\fiyat-verisi
